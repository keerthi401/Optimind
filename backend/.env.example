# ========================================================
# OptiMind AI Backend Environment Configuration Template
# ========================================================

# Server Port and Runtime Environment
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins (comma-separated URLs for production & local dev)
FRONTEND_URL=http://localhost:5174,http://localhost:5173

# Database Configuration
# Option A: Supabase PostgreSQL (Recommended - https://supabase.com)
SUPABASE_URL=https://your-project-id.supabase.co
# Use your Supabase Service Role Key (or Anon Key) from Project Settings -> API
SUPABASE_KEY=your_supabase_service_role_key

# Option B: MongoDB Atlas (Optional fallback)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/optimind?retryWrites=true&w=majority
# If both are omitted or unreachable, backend runs in resilient in-memory mode for offline dev

# Security & Authentication (JSON Web Tokens)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_in_production
JWT_EXPIRES_IN=7d

# Google Gemini AI Provider Configuration
# Obtain your free Gemini API key from https://aistudio.google.com/
# If omitted, OptiMind AI automatically activates its structured educational synthesis engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Storage & File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=15728640

# Rate Limiting (15 minutes window, 300 requests per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

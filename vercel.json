{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "optimind-ai-backend": {
      "root": "backend",
      "framework": "express",
      "buildCommand": "npm install"
    },
    "optimind-ai-frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm install && npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "optimind-ai-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "optimind-ai-frontend"
      }
    }
  ]
}
